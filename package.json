{
  "name": "comsoc-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["website", "cms"],
  "scripts": {
    "dev": "concurrently -n website,cms -c cyan,magenta \"npm run dev:website\" \"npm run dev:cms\"",
    "dev:website": "npm run dev --workspace=@comsoc/website",
    "dev:cms": "npm run dev --workspace=@comsoc/cms",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
