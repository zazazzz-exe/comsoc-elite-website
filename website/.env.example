# Website app environment variables

# Shared public Supabase settings for published-content reads
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# CMS proxy origin — points to the separate CMS deployment (default: http://localhost:3001)
CMS_ORIGIN=http://localhost:3001

# Server-only shared secret required by POST /api/revalidate from the CMS.
REVALIDATE_SECRET=replace-with-a-long-random-shared-secret
